<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ligg.mapper.FollowMapper">

    <select id="FollowList" resultType="com.ligg.pojo.user.User">
        select *
        from user_follow
        join
            user u on user_follow.user_id = u.id
    </select>
</mapper>
